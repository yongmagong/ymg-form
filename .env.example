# @yongincommunity.org 구글 조직(Workspace) 계정이면 처음 로그인할 때 자동으로
# 관리자로 등록됩니다. 다른 도메인을 쓰신다면 여기에 그 도메인으로 바꿔주세요.
# 그 외 개인 계정(Gmail 등)을 허용/차단하는 것은 이제 배포 후 /admin/staff 화면에서 관리합니다.
ADMIN_ALLOWED_DOMAIN=yongincommunity.org

# 관리자 로그인용 구글 OAuth 클라이언트 (구글시트 연동 서비스 계정과는 별개입니다)
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx

# NextAuth 쿠키 서명용 비밀 문자열 (임의의 긴 문자열로 변경)
NEXTAUTH_SECRET=change-me-too
# 배포된 실제 주소
NEXTAUTH_URL=https://ymg-form.vercel.app

# 구글 서비스 계정 (구글시트 API 접근용)
GOOGLE_CLIENT_EMAIL=xxxx@xxxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 기록할 구글시트 ID (URL의 /d/ 와 /edit 사이 값)
GOOGLE_SHEET_ID=18e0DJ5W_ENBt4kQCIyDp0Zzk1hczN8_luM_oAGaI0H4

# 기록함 PDF/HTML 첨부파일 저장용 (Vercel 프로젝트 → Storage → Blob 생성 시 자동 발급)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx
